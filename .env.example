# gh-review-tool — optional environment configuration
#
# This tool does NOT require any environment variables.
# Authentication is handled entirely by:
#   - the gh CLI (run `gh auth login` once)
#   - your AI provider's own CLI (opencode auth, claude login, etc.)
#
# Optional:
#
# Selects which AI backend to use. Supported values: opencode, claude-code.
# When unset, the first provider whose CLI is on PATH is auto-selected
# (opencode preferred). Live-switchable from the UI without a restart.
# AI_PROVIDER=opencode
#
# The following variables are intentionally stripped from every subprocess
# environment so that child processes use the gh CLI's keyring auth instead
# of inheriting a token:
#   GITHUB_TOKEN  (removed automatically if set)
#   GH_TOKEN      (removed automatically if set)
#
# This prevents accidental token leakage into opencode, claude, git, or any
# other subprocess the app spawns.

# Maximum characters of unified diff sent to the LLM in a single review call.
# When the PR diff exceeds this, ReviewService splits it by file, runs N
# sub-reviews in parallel (see REVIEW_MAX_CONCURRENCY), prepends the full PR
# file manifest to each sub-call for cross-file context, and merges the
# findings. Default 150000 (sized for large-context models such as Sonnet or
# Opus, so most PRs are reviewed coherently in a single call) — lower it for
# small-context models.
# REVIEW_DIFF_MAX_CHARS=150000

# Maximum number of sub-reviews to run in parallel when a large diff is split.
# Each sub-review spawns a claude/opencode subprocess, so memory and rate
# limits scale with this number. Default 3.
# REVIEW_MAX_CONCURRENCY=3

# After a split review, run one extra AI pass that consolidates the per-chunk
# findings: semantic dedupe (the same issue reported from different chunks),
# consistent priority ranking, and a single coherent summary. Falls back to
# the mechanical merge on any failure. Default true; set 0/false to disable.
# REVIEW_SYNTHESIS=true

# Comma-separated glob patterns for files excluded from review (lockfiles,
# build artifacts, minified/vendored code...). A pattern matches the full
# path or the basename. Unset → built-in defaults; set to an empty value to
# disable filtering entirely.
# REVIEW_IGNORE_GLOBS=*.lock,dist/*,*.min.js

# Console log level (DEBUG, INFO, WARNING, ERROR). Default INFO.
# LOG_LEVEL=INFO

# Maximum number of open PRs fetched per repo (gh pr list --limit). Default 50.
# PR_LIST_LIMIT=50

# Where per-run metrics records land (JSONL, metadata only — never code or
# review text). Served aggregated by GET /api/stats. Default .cache/metrics.jsonl.
# METRICS_FILE=.cache/metrics.jsonl
