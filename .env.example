# gh-review-tool — optional environment configuration
#
# This tool does NOT require any environment variables.
# Authentication is handled entirely by:
#   - the gh CLI (run `gh auth login` once)
#   - your AI provider's own CLI (opencode auth, claude login, etc.)
#
# Running via Docker (the default — see README.md#installation-docker-default):
# copy this file to `.env` and `docker compose` / `docker-launch.sh` will pick
# it up automatically for variable substitution in docker-compose.yml,
# including the Docker-only `API_PORT` (host port to publish, default 8000).
# API_PORT=8000
#
# Optional:
#
# Selects which AI backend to use. Supported values: opencode, claude-code.
# When unset, the first provider whose CLI is on PATH is auto-selected
# (opencode preferred). Live-switchable from the UI without a restart.
# AI_PROVIDER=opencode
#
# The following variables are intentionally stripped from every subprocess
# environment so that child processes use the gh CLI's keyring auth instead
# of inheriting a token:
#   GITHUB_TOKEN  (removed automatically if set)
#   GH_TOKEN      (removed automatically if set)
#
# This prevents accidental token leakage into opencode, claude, git, or any
# other subprocess the app spawns.

# Maximum characters of unified diff sent to the LLM in a single review call.
# When the PR diff exceeds this, ReviewService splits it by file, runs N
# sub-reviews in parallel (see REVIEW_MAX_CONCURRENCY), prepends the full PR
# file manifest to each sub-call for cross-file context, and merges the
# findings. Default 150000 (sized for large-context models such as Sonnet or
# Opus, so most PRs are reviewed coherently in a single call) — lower it for
# small-context models.
# REVIEW_DIFF_MAX_CHARS=150000

# Maximum number of reviews to run in parallel. This primarily caps how many
# PR reviews the UI's review queue runs at once when you batch-review several
# PRs; it also bounds the parallel sub-reviews on the rare path where a diff
# exceeds REVIEW_DIFF_MAX_CHARS and gets split. Each concurrent review spawns a
# claude/opencode subprocess, so memory and rate limits scale with this number.
# Default 3.
# REVIEW_MAX_CONCURRENCY=3

# After a split review, run one extra AI pass that consolidates the per-chunk
# findings: semantic dedupe (the same issue reported from different chunks),
# consistent priority ranking, and a single coherent summary. Falls back to
# the mechanical merge on any failure. Default true; set 0/false to disable.
# REVIEW_SYNTHESIS=true

# Comma-separated glob patterns for files excluded from review (lockfiles,
# build artifacts, minified/vendored code...). A pattern matches the full
# path or the basename. Unset → built-in defaults; set to an empty value to
# disable filtering entirely.
# REVIEW_IGNORE_GLOBS=*.lock,dist/*,*.min.js

# Seconds between two Live Review poll cycles (the background watcher that
# auto-reviews new/updated PRs when started from the Live tab). Each cycle
# runs one `gh pr list` per registered repo. Default 300 (5 minutes); also
# configurable from Settings in the UI.
# LIVE_REVIEW_POLL_INTERVAL=300

# Start the Live Review watcher automatically at boot ("review-auto" mode), so
# new/updated non-draft PRs are reviewed the moment the UI opens — no manual
# Start. Set by `--mode review-auto` on docker-launch.sh / launch.sh. Default
# off; also toggleable from Settings in the UI.
# LIVE_REVIEW_AUTOSTART=0

# Seconds between automatic refreshes of the open-PR list in the UI. Default
# 900 (15 minutes); bounds 30–86400. Also configurable from Settings.
# PR_LIST_REFRESH_INTERVAL=900

# Console log level (DEBUG, INFO, WARNING, ERROR). Default INFO.
# LOG_LEVEL=INFO

# Maximum number of open PRs fetched per repo (gh pr list --limit). Default 50.
# PR_LIST_LIMIT=50

# Where per-run metrics records land (JSONL, metadata only — never code or
# review text). Served aggregated by GET /api/stats. Default .cache/metrics.jsonl.
# METRICS_FILE=.cache/metrics.jsonl

# --- Agent Skills -----------------------------------------------------------
#
# On startup the app links the Skills bundled under `claude_skills/` into the
# global skills dir (`~/.claude/skills/`, honouring CLAUDE_CONFIG_DIR) so BOTH
# the opencode and claude connectors auto-discover them, alongside any Skills
# you already have globally. A pre-existing global skill of the same name is
# never overwritten — yours wins. The install is idempotent and best-effort.

# Override the bundled-skills source directory (absolute, or relative to the
# repo root). Default: claude_skills.
# GH_REVIEW_SKILLS_DIR=claude_skills

# Claude Code read-only review runs no longer pass `--bare` (which would skip
# Skill / hook / CLAUDE.md auto-discovery). Set this to 1 to restore the legacy
# `--bare` path — useful on deployments (e.g. some AWS Bedrock setups) where the
# non-bare model-validation path rejects otherwise-valid model IDs. Note: when
# set, the bundled Skills will NOT be picked up by Claude review runs.
# CLAUDE_CODE_BARE=0
